# Omi keeps personal data out of git by where and how it stores it: every
# setting, user, password and token is an .ini file in settings/, and Omi's
# own database is in db/. Only the two examples in settings/, with placeholder
# passwords, are tracked.
*.ini
!/settings/settings.example.ini
!/settings/users.example.ini
/db/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# The server's runtime files in the Omi folder: who failed to log in, rate
# limits, sessions, activity, repositories, Gitea jobs and the size index.
/repos/
/usersfailedattempts.txt
/api_rate_limit.txt
/session_invalidate_flags.json
/activity.log
/gitea-jobs/
/gitea-index.txt
/gitea-index.txt.tmp
*.stop
.env
.env.*

# Executables and build output: the Free Pascal server and its objects,
# embedded SQLite, the command-line clients, the Amiga build.
/build/
/public/server
/public/server.new
/public/*.o
/public/*.ppu
/cli/build/
*.o
*.obj
*.ppu
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.com
*.hdll
*.class
*.jar
*.pyc
*.pyo
__pycache__/
node_modules/
bin/
obj/
*.pdb
*.n
*.hl

# Temporary files
/tmp/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.log
*.swp
*.swo
*~
.#*
.directory
.DS_Store
Thumbs.db
.vscode/
.idea/
